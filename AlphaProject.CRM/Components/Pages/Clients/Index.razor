@page "/clients"
@using AlphaProject.Shared.Dtos
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid

@attribute [Authorize]

@inject NavigationManager NavigationManager
@inject AlphaProject.CRM.ClientsService cliService

<PageTitle>Clients</PageTitle>

<h3>Gestione Clienti</h3>

@if (clients is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <!-- casella di ricerca per filtrare -->
    <input type="search" class="form-control mb-2" @bind="searchString" placeholder="Cerca clienti..." />

    <!-- griglia con colonne ordinabili -->

    <QuickGrid TGridItem="ClientDto" Items="filteredClients" Class="table table-striped" >
        <PropertyColumn Property="@(c => c.FirstName)" Title="Nome" Sortable="true" />
        <PropertyColumn Property="@(c => c.LastName)" Title="Cognome" Sortable="true" />
        <PropertyColumn Property="@(c => c.Email)" Title="Email" Sortable="true" />
        <PropertyColumn Property="@(c => c.Phone)" Title="Telefono" Sortable="true" />
        <TemplateColumn TGridItem="ClientDto" Title="Azioni">
            <ChildContent Context="context">
                <a class="btn btn-sm btn-primary"
                   href="/clients/edit/@context.ClientId">
                    Modifica
                </a>
                <button class="btn btn-sm btn-danger"
                        @onclick="@(() => Delete(context.ClientId))">
                    Elimina
                </button>
            </ChildContent>
        </TemplateColumn>
    </QuickGrid>
}

@code {
    private List<ClientDto>? clients;
    private string searchString = string.Empty;

    private IQueryable<ClientDto> filteredClients =>
        string.IsNullOrWhiteSpace(searchString)
            ? clients?.AsQueryable() ?? Enumerable.Empty<ClientDto>().AsQueryable()
            : clients?.Where(c =>
                (!string.IsNullOrEmpty(c.FirstName) && c.FirstName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.LastName) && c.LastName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.Email) && c.Email.Contains(searchString, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.Phone) && c.Phone.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            ).AsQueryable() ?? Enumerable.Empty<ClientDto>().AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        clients = await cliService.GetClientsAsync();
    }

    private async Task Delete(int id)
    {
        if (await cliService.DeleteClientAsync(id))
        {
            clients = await cliService.GetClientsAsync();
        }
    }
}
