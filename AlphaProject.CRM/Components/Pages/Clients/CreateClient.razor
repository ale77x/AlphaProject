@page "/clients/create"

@using AlphaProject.Shared.Dtos
@using Microsoft.AspNetCore.Authorization


@attribute [Authorize]

@inject NavigationManager NavigationManager

@inject AlphaProject.CRM.ClientsService cliService


@rendermode InteractiveServer

<PageTitle>Crea Cliente</PageTitle>


<ClientForm OnValidSubmit="OnClientCreated" SubmitLabel="Crea Cliente" Client="currentClient" />

@code {

    private ClientDto currentClient = new();

    private async Task OnClientCreated(ClientDto cli)
    {
        // Uso il client passato dal child per essere sicuro di avere i valori correnti
        var result = await cliService.CreateClientAsync(cli);

        if (result)
        { 
            NavigationManager.NavigateTo("/clients");
        }
    }
}
